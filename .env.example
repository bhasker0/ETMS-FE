# Surat Embroidery Micro-ERP (SASA) Environment Configuration
NEXT_PUBLIC_APP_NAME="Surat Embroidery Micro-ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_DEFAULT_LOCALE="gu"

# Ports
FRONTEND_PORT=3002
NGINX_PORT=8080

# API & Backend Services
NEXT_PUBLIC_API_BASE_URL="http://localhost:3002/api"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Development Features
NEXT_PUBLIC_ENABLE_AUTO_LOGIN="false"

# Munim & GST Configuration
DEFAULT_GST_RATE="5.0"
DEFAULT_SAC_CODE="9988"
TALLY_COMPANY_NAME="SHREE GANESH EMBROIDERY WORKS"

# Logging & Diagnostic Server
CLIENT_LOG_LEVEL="info"
NODE_ENV="production"
PORT=3000
